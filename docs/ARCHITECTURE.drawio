  <diagram id="data-flow" name="Data Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="df-title" value="&lt;b&gt;Clinical Assessment Data Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#0077B6;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step1" value="&lt;b&gt;1. DATA INGESTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;IoT devices send vitals&lt;br&gt;(HR, BP, SpO2, Temp)&lt;br&gt;↓&lt;br&gt;Backend stores in DB&lt;br&gt;↓&lt;br&gt;Syncs to FHIR Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="200" height="160" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="step2" value="&lt;b&gt;2. AI ASSESSMENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Orchestrator receives request&lt;br&gt;↓&lt;br&gt;Queries MCP servers&lt;br&gt;(FHIR, Labs, RAG, Pharmacy)&lt;br&gt;↓&lt;br&gt;Enriches patient context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="step3" value="&lt;b&gt;3. MULTI-AGENT ANALYSIS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Supervisor delegates to&lt;br&gt;specialist agents&lt;br&gt;↓&lt;br&gt;Each agent analyzes with&lt;br&gt;domain expertise&lt;br&gt;↓&lt;br&gt;Results consolidated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="570" y="100" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="step4" value="&lt;b&gt;4. PHYSICIAN REVIEW&lt;/b&gt;&lt;br&gt;&lt;br&gt;Doctor reviews assessment&lt;br&gt;on dashboard&lt;br&gt;↓&lt;br&gt;Approves, modifies, or&lt;br&gt;rejects recommendations&lt;br&gt;↓&lt;br&gt;Digital signature applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="220" height="160" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
