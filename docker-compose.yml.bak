#version: "3.9"

services:
  db:
    image: pgvector/pgvector:pg16 
    environment:
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: healthapp
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d healthapp"]
      interval: 5s
      timeout: 3s
      retries: 20



        
  redis:
    image: redis:7

  backend:
    build: ./backend
      #command: python manage.py runserver 0.0.0.0:8000
    command: bash -lc "./wait_for_db.sh && python manage.py migrate && python manage.py runserver 0.0.0.0:8000 --noreload"

    volumes: [./backend:/app]
    ports: ["8000:8000"]
    depends_on: [db, redis]

  worker:
    build: ./backend
    command: celery -A config worker --loglevel=info
    depends_on: [backend, redis]

  orchestrator:
    build: ./orchestrator
    command: uvicorn app:app --host 0.0.0.0 --port 8003
    ports: ["8003:8003"]

      #mcp-server:
      #image: teradata/mcp-server:latest
      #ports: ["8002:8002"]

  hapi-fhir:
    image: hapiproject/hapi:latest
    ports: ["18090:8080"]

  mcp-fhir-adapter:
    build: ./mcp/tool_adapters/fhir_writeback
    command: uvicorn app:app --host 0.0.0.0 --port 8002
    environment:
      FHIR_BASE: "http://hapi-fhir:8080/fhir"
    ports: ["8002:8002"]
    depends_on: [hapi-fhir]

